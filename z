-- Función para buscar el objetivo más cercano a la mira
local function getClosestTargetSilent()
    local centerPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local localPos = char.HumanoidRootPart.Position

    local closest = nil
    local minDist = math.huge

    local targetList = _G.GetRealPlayers and _G.GetRealPlayers() or Players:GetPlayers()

    for _, pl in ipairs(targetList) do
        if pl ~= LocalPlayer and pl.Character then
            local head = pl.Character:FindFirstChild("Head")
            local hum = pl.Character:FindFirstChildOfClass("Humanoid")

            if head and hum and hum.Health > 0 then
                local isTeam = _G.Silent_TeamCheck and LocalPlayer.Team and pl.Team and (pl.Team == LocalPlayer.Team)
                if not isTeam then
                    local dist = (localPos - head.Position).Magnitude
                    if dist <= _G.Silent_Range then
                        local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local screenDist = (Vector2.new(sp.X, sp.Y) - centerPos).Magnitude
                            if screenDist <= _G.Silent_FOV and screenDist < minDist then
                                minDist = screenDist
                                closest = head
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- Comprobar si tenemos arma en mano
local function checkWeapon()
    local char = LocalPlayer.Character
