-- =========================================================================
-- HOOK MAESTRO: INTERCEPTA LA BALÍSTICA DE BQM (GlockEvent y MD_ItemsEvent)
-- Y REDIRIGE Camera:ViewportPointToRay / ScreenPointToRay
-- =========================================================================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if _G.Silent_Enabled and not checkcaller() and CurrentTargetSilent then
        -- [1] REDIRECCIÓN EN EL REMOTE DEL SERVIDOR (Daño Real)
        if method == "FireServer" then
            local remoteName = self.Name
            
            -- Glock (GlockEvent -> "Shoot", predictionTable)
            if remoteName == "GlockEvent" and args[1] == "Shoot" and type(args[2]) == "table" then
                local data = args[2]
                local origin = data.origin or Camera.CFrame.Position
                data.direction = (CurrentTargetSilent.Position - origin).Unit
                return oldNamecall(self, "Shoot", data)
            end

            -- Resto de armas: AK47, AWP, M16, P90, etc. (MD_ItemsEvent -> "FireGun", predictionTable)
            if remoteName == "MD_ItemsEvent" and args[1] == "FireGun" and type(args[2]) == "table" then
                local data = args[2]
                local origin = data.origin or Camera.CFrame.Position
                data.direction = (CurrentTargetSilent.Position - origin).Unit
                return oldNamecall(self, "FireGun", data)
            end
        end

        -- [2] REDIRECCIÓN DE RAYOS DE CÁMARA (Para MD_TracerVisual y visuales)
        if self == Camera and (method == "ViewportPointToRay" or method == "ScreenPointToRay") then
            local origin = Camera.CFrame.Position
            local dir = (CurrentTargetSilent.Position - origin).Unit
            return Ray.new(origin, dir)
        end

        -- [3] REDIRECCIÓN POR RAYCAST TRADICIONAL (Fallback)
        if self == workspace and method == "Raycast" then
            local origin = args[1]
            if typeof(origin) == "Vector3" then
                args[2] = (CurrentTargetSilent.Position - origin).Unit * 500
                return oldNamecall(self, unpack(args))
            end
        end
    end

    return oldNamecall(self, ...)
end))

-- Bucle de render y actualización de objetivo
RunService.RenderStepped:Connect(function()
    checkWeapon()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if _G.Silent_Enabled and WeaponEquipped then
        CurrentTargetSilent = getClosestTargetSilent()
    else
        CurrentTargetSilent = nil
    end

    -- Actualizar Círculo FOV
    FOVCircleSilent.Position = center
    FOVCircleSilent.Radius = _G.Silent_FOV
    FOVCircleSilent.Visible = _G.Silent_Enabled and _G.Silent_ShowFOV

    -- Actualizar Línea al Blanco
    if CurrentTargetSilent and _G.Silent_Enabled then
        local sp, onScreen = Camera:WorldToViewportPoint(CurrentTargetSilent.Position)
        if onScreen then
            TracerSilent.From = center
            TracerSilent.To = Vector2.new(sp.X, sp.Y)
            TracerSilent.Visible = true
        else
            TracerSilent.Visible = false
        end
    else
        TracerSilent.Visible = false
    end
end)

