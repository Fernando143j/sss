    Desc = "Guarda los ajustes actuales con el nombre escrito arriba",
    Callback = function()
        if not SaveConfigName or SaveConfigName == "" then
            WindUI:Notify({ Title = "Error", Content = "Escribe un nombre en la casilla superior.", Icon = "x", Duration = 3 })
            return
        end

        local saved = GetSavedConfigs()
        local alreadyExists = false
        for _, name in ipairs(saved) do
